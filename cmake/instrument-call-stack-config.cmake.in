@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# If Lua target exists, expose dependency
if(TARGET instrument-call-stack-lua)
    find_dependency(Lua)
endif()

# Load exported targets
include("${CMAKE_CURRENT_LIST_DIR}/instrument-call-stack-targets.cmake")

# Handle requested components
set(_supported_components lua)

foreach(_comp ${instrument_call_stack_FIND_COMPONENTS})
    if(NOT _comp IN_LIST _supported_components)
        message(FATAL_ERROR "Unsupported component: ${_comp}")
    endif()

    if(_comp STREQUAL "lua")
        if(NOT TARGET instrument-call-stack-lua)
            set(instrument-call-stack_lua_FOUND FALSE)
        else()
            set(instrument-call-stack_lua_FOUND TRUE)
        endif()
    endif()
endforeach()

check_required_components(instrument-call-stack)
